(version 1)
;; generated by wikiskilld — rollout/verifier profile
(deny default)
(allow process-fork)
(allow signal (target same-sandbox))
(allow sysctl-read)
(allow mach-lookup)
(allow process-exec)
(allow file-read-metadata)

;; readable: the system, the toolchain and the work tree
(allow file-read*
  (subpath "/usr")
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/System")
  (subpath "/Library")
  (subpath "/opt")
  (subpath "/private/etc")
  (subpath "/private/var/db/dyld")
  (subpath "/dev")
  (subpath "<your home>/Library/Application Support/wikiskill/work")
)

;; writable: the work tree and temp only
(allow file-write*
  (subpath "<your home>/Library/Application Support/wikiskill/work")
  (subpath "/private/tmp")
  (subpath "/private/var/tmp")
  (subpath "/private/var/folders")
  (literal "/dev/null")
  (literal "/dev/dtracehelper")
  (regex #"^/dev/tty")
)

;; the inference agent must never read the wiki
(deny file-read* file-write*
  (subpath "<your vault>")
)

(allow network-outbound)
(allow network-bind)

