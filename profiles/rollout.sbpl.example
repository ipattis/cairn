(version 1)
;; generated by wikiskilld — rollout/verifier profile
(deny default)
(allow process-fork)
(allow signal (target same-sandbox))
(allow sysctl-read)
(allow mach-lookup)
(allow process-exec)
(allow file-read-metadata)

;; readable: the system, the toolchain and the work tree
(allow file-read*
  (literal "/")
  (subpath "/usr")
  (subpath "/bin")
  (subpath "/sbin")
  (subpath "/System")
  (subpath "/Library")
  (subpath "/opt")
  (subpath "/private/etc")
  (subpath "/private/var/db/dyld")
  (subpath "/private/var/db/timezone")
  (subpath "/dev")
  (subpath "/private/tmp")
  (subpath "/private/var/tmp")
  (subpath "/private/var/folders")
  ;; directory nodes only — listable, not readable; see README.md
  (literal "/Users")
  (literal "<your home>")
  (literal "<your home>/.claude")
  (literal "<your home>/Library")
  (literal "<your home>/Library/Application Support")
  (subpath "<your home>/Library/Application Support/wikiskill")
  (subpath "<your home>/Library/Application Support/wikiskill/rollout-home")
  (subpath "<your toolchain, from sandbox.extra_read_paths>")
)

;; writable: the work tree, the agent's home and temp only
(allow file-write*
  (subpath "<your home>/Library/Application Support/wikiskill")
  (subpath "<your home>/Library/Application Support/wikiskill/rollout-home")
  (subpath "/private/tmp")
  (subpath "/private/var/tmp")
  (subpath "/private/var/folders")
  (literal "/dev/null")
  (literal "/dev/dtracehelper")
  (regex #"^/dev/tty")
  (subpath "<your home>/Library/Application Support/wikiskill/rollout-home")
)

;; the inference agent must never read the wiki
(deny file-read* file-write*
  (subpath "<your vault>")
)

(allow network-outbound)
(allow network-bind)
(allow network-inbound)

