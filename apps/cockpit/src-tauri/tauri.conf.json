{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WikiSkill Cockpit",
  "version": "0.1.0",
  "identifier": "ai.wikiskill.cockpit",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "WikiSkill Cockpit",
        "width": 1280,
        "height": 860,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "targets": ["app"],
    "category": "DeveloperTool",
    "shortDescription": "Cockpit for the WikiSkill daemon"
  }
}
